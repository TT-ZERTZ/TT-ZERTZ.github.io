javascript:(function(){if(document.getElementById('bt-panel'))document.getElementById('bt-panel').remove();const css=document.createElement('style');css.textContent=`#bt-panel{position:fixed;top:80px;right:20px;z-index:999999;background:#181818;color:#fff;padding:15px;border-radius:12px;font-family:sans-serif;box-shadow:0 8px 32px rgba(0,0,0,.5);border:1px solid #333;width:280px;user-select:none}#bt-panel h3{margin:0 0 10px;font-size:16px;color:#3ea6ff;display:flex;justify-content:space-between;align-items:center;cursor:move}#bt-panel .bt-btns{display:flex;gap:6px;align-items:center}#bt-panel button.bt-ctrl{background:none;border:none;color:#aaa;font-size:16px;cursor:pointer}#bt-panel button.bt-ctrl:hover{color:#fff}#bt-panel .bt-content{display:block}#bt-panel.minimized .bt-content{display:none}#bt-panel .bt-row{margin-bottom:10px;display:flex;flex-direction:column}#bt-panel label{font-size:12px;margin-bottom:4px;color:#aaa}#bt-panel input{background:#121212;border:1px solid #444;color:#fff;padding:6px;border-radius:6px;font-size:14px}#bt-panel button.bt-action{background:#3ea6ff;color:#000;border:none;padding:6px;border-radius:6px;font-weight:bold;cursor:pointer;margin-top:4px}#bt-panel button.bt-action:hover{background:#65b8ff}#bt-status{font-size:11px;color:#aaa;margin-top:4px;text-align:center}`;document.head.appendChild(css);const panel=document.createElement('div');panel.id='bt-panel';const h=document.createElement('h3');const span=document.createElement('span');span.textContent='🚀 BetterTube (Pro)';h.appendChild(span);const btns=document.createElement('div');btns.className='bt-btns';const minBtn=document.createElement('button');minBtn.className='bt-ctrl';minBtn.textContent='_';minBtn.title='Minimize/Restore';const closeBtn=document.createElement('button');closeBtn.className='bt-ctrl';closeBtn.textContent='×';closeBtn.title='Close';btns.appendChild(minBtn);btns.appendChild(closeBtn);h.appendChild(btns);panel.appendChild(h);const content=document.createElement('div');content.className='bt-content';const r1=document.createElement('div');r1.className='bt-row';const l1=document.createElement('label');l1.textContent='Custom Speed (up to 1000x)';const i1=document.createElement('input');i1.type='number';i1.id='bt-speed-input';i1.step='1';i1.min='0.1';i1.max='1000';i1.value='1';const b1=document.createElement('button');b1.className='bt-action';b1.id='bt-set-speed';b1.textContent='Apply Speed';r1.appendChild(l1);r1.appendChild(i1);r1.appendChild(b1);content.appendChild(r1);const r2=document.createElement('div');r2.className='bt-row';const l2=document.createElement('label');l2.textContent='Search Comments (YouTube Only)';const i2=document.createElement('input');i2.type='text';i2.id='bt-comment-search';i2.placeholder='Type keyword...';const b2=document.createElement('button');b2.className='bt-action';b2.id='bt-find-comment';b2.textContent='Highlight Matches';r2.appendChild(l2);r2.appendChild(i2);r2.appendChild(b2);content.appendChild(r2);const r3=document.createElement('div');r3.className='bt-row';const b3=document.createElement('button');b3.className='bt-action';b3.style.cssText='background:#2ba640;color:#fff';b3.textContent='⚡ Smart Ad-Skipper Active';r3.appendChild(b3);content.appendChild(r3);const st=document.createElement('div');st.id='bt-status';st.textContent='Status: Ready';content.appendChild(st);panel.appendChild(content);document.body.appendChild(panel);let isDragging=false,startX,startY,initialX,initialY;h.onmousedown=function(e){if(e.target.tagName==='BUTTON'||e.target.closest('button'))return;isDragging=true;startX=e.clientX;startY=e.clientY;initialX=panel.offsetLeft;initialY=panel.offsetTop;document.onmousemove=function(e2){if(!isDragging)return;panel.style.left=(initialX+(e2.clientX-startX))+'px';panel.style.top=(initialY+(e2.clientY-startY))+'px';panel.style.right='auto';};document.onmouseup=function(){isDragging=false;document.onmousemove=null;document.onmouseup=null;};};minBtn.onclick=function(){panel.classList.toggle('minimized');minBtn.textContent=panel.classList.contains('minimized')?'+':'_';};closeBtn.onclick=function(){panel.remove();};document.getElementById('bt-set-speed').onclick=function(){let s=parseFloat(document.getElementById('bt-speed-input').value);const v=document.querySelector('video');if(v){if(s<=16){try{v.playbackRate=s;v.removeAttribute('data-bt-hyper');st.textContent='Speed set to '+s+'x';}catch(e){}}else{v.playbackRate=16;v.setAttribute('data-bt-hyper',s);st.textContent='Hyper-speed set to '+s+'x!';}}else{st.textContent='Error: No media found';}};document.getElementById('bt-find-comment').onclick=function(){const kw=document.getElementById('bt-comment-search').value.toLowerCase();if(!kw)return;let count=0;document.querySelectorAll('ytd-comment-thread-renderer').forEach(function(c){if(c.innerText.toLowerCase().includes(kw)){c.style.border='2px solid #3ea6ff';c.style.background='rgba(62,166,255,0.05)';c.scrollIntoView({behavior:'smooth',block:'center'});count++;}});st.textContent='Found '+count+' matches for "'+kw+'"';};setInterval(function(){const vid=document.querySelector('video');if(vid){let hyper=vid.getAttribute('data-bt-hyper');if(hyper&&!vid.paused){let targetStep=parseFloat(hyper)/50;vid.currentTime=Math.min(vid.duration,vid.currentTime+targetStep);}const isAdPlaying=document.querySelector('.ad-showing')||document.querySelector('.ad-interrupting')||document.querySelector('.video-ads.ad-showing');const skipBtn=document.querySelector('.ytp-ad-skip-button, .ytp-ad-skip-button-modern, .audio-ad-skip-button');if(skipBtn){skipBtn.click();}if(isAdPlaying){if(!isNaN(vid.duration)&&vid.duration>0){vid.currentTime=vid.duration;}else{vid.currentTime+=10;}vid.muted=true;}}},100);console.log('🚀 Fixed BetterTube injected successfully!');})();
